   "source": [
    " A single-phase transformer with a voltage regulation of\n",
    " 2% has a secondary terminal voltage of 130 V at full\n",
    " load. Calculate its no-load secondary terminal volt\n",
    "age"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "200494d3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "No load voltage is  132.6\n"
     ]
    }
   ],
   "source": [
    "Vreg = 2 ##percentage\n",
    "Vfl = 130 ##V\n",
    "Vnl = Vreg*10**(-2) * Vfl + Vfl\n",
    "print(\"No load voltage is \",Vnl)"
   ]
  },
